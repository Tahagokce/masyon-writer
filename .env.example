# Export these in your shell; the runner deliberately does not auto-load .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
WBS_USERNAME=
WBS_PASSWORD=
WBS_BASE_URL=
# Built fork repository root (must contain packages/playwright-core/lib/coreBundle.js).
PLAYWRIGHT_FORK_PATH=
# Optional absolute path to the fork's built playwright-core package instead.
# PLAYWRIGHT_FORK_PATH=/path/to/fork/packages/playwright-core
# JSON argv, no shell evaluation. Default is node bridge/server.mjs.
PLAYWRIGHT_MCP_COMMAND=
# Optional browser executable; this does not change the Playwright library.
PLAYWRIGHT_EXECUTABLE_PATH=
# Absolute path to the external Java+Cucumber automation repository (Phase 2).
AUTOMATION_REPO_PATH=
HEADLESS=true
LOG_LEVEL=INFO
LOG_LOCATORS=false
# Comma-separated secret environment variable names available to browser tools.
SECRET_ENV_NAMES=WBS_USERNAME,WBS_PASSWORD
MAX_STEP_CALLS=30
STEP_TIMEOUT_SECONDS=300
TOOL_TIMEOUT_SECONDS=60
